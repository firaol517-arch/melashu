# ---- Public (safe for browser) ----
NEXT_PUBLIC_APP_NAME="Tsehafi AI"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=replace-me
# 32 random bytes, base64. Generate: openssl rand -base64 32
SESSION_ENC_KEY=replace-me
# ---- AI provider (OpenAI-compatible). Default = Google Gemini free tier ----
# Get a key: https://aistudio.google.com/apikey  (no billing needed for the free tier)
# NOTE: on Google's FREE tier, prompts/responses may be used to improve Google products and read by human reviewers.
AI_API_KEY=replace-me
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.8-flash
# To use OpenAI instead: AI_API_KEY=<openai key>, remove AI_BASE_URL, AI_MODEL=gpt-4o-mini
